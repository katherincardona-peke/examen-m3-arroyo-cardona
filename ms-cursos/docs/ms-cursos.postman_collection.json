      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Responde 200', () => pm.response.to.have.status(200));",
              "pm.test('Devuelve un arreglo', () => pm.expect(pm.response.json()).to.be.an('array'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base}}/cursos"
      }
    },
    {
      "name": "07 ms-salones APAGADO GET /cursos - 200 salon null y aviso",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Responde 200', () => pm.response.to.have.status(200));",
              "pm.test('salon null y aviso', () => { const c = pm.response.json()[0]; pm.expect(c.salon).to.equal(null); pm.expect(c.aviso).to.be.a('string'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base}}/cursos"
      }
