{
  "info": {
    "name": "ms-cursos",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base",
      "value": "http://127.0.0.1:3011"
    },
    {
      "key": "login",
      "value": "http://127.0.0.1:3001/usuarios/login"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "00 Login administrador - 200",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Responde 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('token', pm.response.json().token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{login}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@empresa.com\",\n  \"password\": \"Admin2026*\"\n}"
        },
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "01 POST /cursos salon_id 1 - 201 con salon",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Responde 201', () => pm.response.to.have.status(201));",
              "pm.test('Trae el objeto salon', () => pm.expect(pm.response.json().salon).to.be.an('object'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base}}/cursos",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"codigo\": \"EXM-{{$randomInt}}\",\n  \"nombre\": \"Curso examen M3\",\n  \"creditos\": 3,\n  \"cupo\": 30,\n  \"semestre\": \"2026-2\",\n  \"salon_id\": 1\n}"
        }
      }
    },
    {
      "name": "02 POST /cursos salon_id 99 - 400 no existe",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
