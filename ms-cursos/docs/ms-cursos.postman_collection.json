      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Responde 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
