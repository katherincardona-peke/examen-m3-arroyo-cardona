{
  "info": {
    "name": "ms-cursos",
    "description": "Evaluación Módulo 3 · Redes y Servicios Multimedia (UAO). Login y un caso por cada código de respuesta de ms-cursos. El token del login se copia y se pega en la variable token (y el de flota en token_flota). Para correrla por el gateway, cambie las variables base y login.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "00 Login administrador - 200",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{login}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@empresa.com\",\n  \"password\": \"Admin2026*\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "01 Login flota - 200",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{login}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"flota@empresa.com\",\n  \"password\": \"CLAVE-DE-FLOTA\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "02 Health - 200",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base}}/health",
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "03 Listar cursos - 200",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base}}/cursos"
      }
    },
    {
      "name": "04 Filtrar por semestre - 200",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base}}/cursos?semestre=2026-2"
      }
    },
    {
      "name": "05 Filtro con formato invalido - 400",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base}}/cursos?semestre=2026-5"
      }
    },
