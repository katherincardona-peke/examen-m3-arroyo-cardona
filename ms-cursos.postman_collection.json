          "raw": "{\n  \"codigo\": \"PRB-403\",\n  \"nombre\": \"Prueba 403\",\n  \"creditos\": 2,\n  \"cupo\": 10,\n  \"semestre\": \"2026-2\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token_flota}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "19 Eliminar curso - 204",
      "request": {
        "method": "DELETE",
        "header": [],
