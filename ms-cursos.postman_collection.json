    {
      "name": "15 Listar sin token - 401",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base}}/cursos",
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "16 Listar con token alterado - 401",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base}}/cursos",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "token-alterado-123",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "17 Listar con rol flota - 200",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base}}/cursos",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token_flota}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "18 Crear con rol flota - 403",
      "request": {
        "method": "POST",
        "header": [
