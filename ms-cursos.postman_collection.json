          }
        ],
        "url": "{{base}}/cursos",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"codigo\": \"ELE-110\",\n  \"nombre\": \"Electrónica Básica\",\n  \"creditos\": 3,\n  \"cupo\": 20,\n  \"semestre\": \"2026-2\"\n}",
          "options": {
            "raw": {
